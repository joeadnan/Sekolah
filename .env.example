# Turso / libSQL database
# Dapatkan dari Turso dashboard atau Turso CLI.
TURSO_DATABASE_URL="libsql://nama-database-nama-org.turso.io"
TURSO_AUTH_TOKEN="isi-token-turso-kamu"

# Admin login
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin12345"

# Gunakan string random panjang minimal 32 karakter.
SESSION_SECRET="ganti-dengan-string-random-panjang-minimal-32-karakter"

# Local development
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Production example:
# NEXT_PUBLIC_APP_URL="https://nama-project.vercel.app"
